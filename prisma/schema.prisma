generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("CATWORLD_DATABASE_URL")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(160)
  email        String        @unique @db.VarChar(320)
  passwordHash String        @map("password_hash") @db.VarChar(500)
  role         String        @default("VIEWER") @db.VarChar(32)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  grants       AccessGrant[]
  savedQueries SavedQuery[]
  auditEvents  AuditEvent[]

  @@map("cw_users")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(100)
  description String?       @db.VarChar(1000)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  datasets    Dataset[]
  grants      AccessGrant[]

  @@map("cw_projects")
}

model Dataset {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  name        String         @db.VarChar(255)
  slug        String         @db.VarChar(100)
  description String?        @db.VarChar(1000)
  schemaName      String         @unique @map("schema_name") @db.VarChar(128)
  storageServerId String?        @map("storage_server_id") @db.Uuid
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamp(3)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  storageServer   StorageServer? @relation(fields: [storageServerId], references: [id])
  tables          DatasetTable[]
  grants          AccessGrant[]
  uploads         Upload[]
  sources         DatasetSource[]
  derivedTables   DerivedTable[]

  @@unique([projectId, slug])
  @@index([projectId, active])
  @@map("cw_datasets")
}

model DatasetTable {
  id        String           @id @default(uuid()) @db.Uuid
  datasetId String           @map("dataset_id") @db.Uuid
  name      String           @db.VarChar(255)
  sqlName   String           @map("sql_name") @db.VarChar(128)
  rowCount   BigInt           @default(0) @map("row_count")
  sizeBytes  BigInt           @default(0) @map("size_bytes")
  lastDataAt DateTime?        @map("last_data_at") @db.Timestamp(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamp(3)
  dataset   Dataset          @relation(fields: [datasetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  columns   DatasetColumn[]
  versions  DatasetVersion[]
  uploads      Upload[]
  source       DatasetSource?
  derivedTables DerivedTable[] @relation("DerivedTarget")

  @@unique([datasetId, sqlName])
  @@map("cw_tables")
}

model DatasetColumn {
  id           String       @id @default(uuid()) @db.Uuid
  tableId      String       @map("table_id") @db.Uuid
  ordinal      Int
  originalName String       @map("original_name") @db.VarChar(255)
  sqlName      String       @map("sql_name") @db.VarChar(128)
  sqlType      String       @map("sql_type") @db.VarChar(100)
  nullable     Boolean      @default(true)
  table        DatasetTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, sqlName])
  @@index([tableId, ordinal])
  @@map("cw_columns")
}

model ApiToken {
  id         String        @id @default(uuid()) @db.Uuid
  name       String        @db.VarChar(160)
  prefix     String        @unique @db.VarChar(24)
  tokenHash  String        @unique @map("token_hash") @db.Char(64)
  active     Boolean       @default(true)
  expiresAt  DateTime?     @map("expires_at") @db.Timestamp(3)
  lastUsedAt DateTime?     @map("last_used_at") @db.Timestamp(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  grants     AccessGrant[]

  @@map("cw_tokens")
}

model DatabaseUser {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @unique @db.VarChar(128)
  kind              String        @db.VarChar(32)
  encryptedPassword String        @map("encrypted_password") @db.VarChar(1000)
  active            Boolean       @default(true)
  lastUsedAt        DateTime?     @map("last_used_at") @db.Timestamp(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  grants            AccessGrant[]

  @@map("cw_database_users")
}

model AccessGrant {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  tokenId        String?       @map("token_id") @db.Uuid
  databaseUserId String?       @map("database_user_id") @db.Uuid
  scopeType      String        @map("scope_type") @db.VarChar(20)
  projectId      String?       @map("project_id") @db.Uuid
  datasetId      String?       @map("dataset_id") @db.Uuid
  permission     String        @db.VarChar(20)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          ApiToken?     @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  databaseUser   DatabaseUser? @relation(fields: [databaseUserId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dataset        Dataset?      @relation(fields: [datasetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([tokenId])
  @@index([databaseUserId])
  @@map("cw_access_grants")
}

model Connection {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String    @db.VarChar(120)
  provider             String    @default("postgres") @db.VarChar(32)
  environment          String    @db.VarChar(32)
  server               String    @db.VarChar(255)
  port                 Int?
  databaseName         String    @map("database_name") @db.VarChar(128)
  sslMode              String    @default("require") @map("ssl_mode") @db.VarChar(32)
  username             String    @db.VarChar(255)
  encryptedCredentials String    @map("encrypted_credentials") @db.VarChar(2000)
  metadataJson         String?   @map("metadata_json") @db.Text
  sshTunnelEnabled     Boolean   @default(false) @map("ssh_tunnel_enabled")
  sshHost              String?   @map("ssh_host") @db.VarChar(255)
  sshPort              Int?      @map("ssh_port")
  sshUsername          String?   @map("ssh_username") @db.VarChar(255)
  sshAuthMethod        String?   @map("ssh_auth_method") @db.VarChar(16)
  sshEncryptedSecret   String?   @map("ssh_encrypted_secret") @db.VarChar(4000)
  active               Boolean   @default(true)
  lastStatus           String?   @map("last_status") @db.VarChar(32)
  lastLatencyMs        Int?      @map("last_latency_ms")
  lastCheckedAt        DateTime? @map("last_checked_at") @db.Timestamp(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
  sources              DatasetSource[]

  @@map("cw_connections")
}

model DatasetSource {
  id              String        @id @default(uuid()) @db.Uuid
  datasetId       String        @map("dataset_id") @db.Uuid
  connectionId    String        @map("connection_id") @db.Uuid
  targetTableId   String?       @unique @map("target_table_id") @db.Uuid
  name            String        @db.VarChar(255)
  mode            String        @db.VarChar(20)
  sourceKind      String        @map("source_kind") @db.VarChar(20)
  sourceGroupId   String?       @map("source_group_id") @db.Uuid
  sourceSchema    String?       @map("source_schema") @db.VarChar(128)
  sourceTable     String?       @map("source_table") @db.VarChar(128)
  sourceSql       String?       @map("source_sql") @db.Text
  refreshCron     String?       @map("refresh_cron") @db.VarChar(100)
  keyColumn       String?       @map("key_column") @db.VarChar(128)
  deltaColumn     String?       @map("delta_column") @db.VarChar(128)
  lastDeltaValue  String?       @map("last_delta_value") @db.Text
  reconciliationCron      String?   @map("reconciliation_cron") @db.VarChar(100)
  sourceSqlReconciliation String?   @map("source_sql_reconciliation") @db.Text
  nextReconciliationAt    DateTime? @map("next_reconciliation_at") @db.Timestamp(3)
  lastReconciliationAt    DateTime? @map("last_reconciliation_at") @db.Timestamp(3)
  lastStatus      String?       @map("last_status") @db.VarChar(32)
  lastRowCount    BigInt?       @map("last_row_count")
  lastError       String?       @map("last_error") @db.Text
  lastRefreshedAt DateTime?     @map("last_refreshed_at") @db.Timestamp(3)
  nextRefreshAt   DateTime?     @map("next_refresh_at") @db.Timestamp(3)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  dataset         Dataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  connection      Connection    @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetTable     DatasetTable? @relation(fields: [targetTableId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([datasetId, active])
  @@index([connectionId])
  @@index([sourceGroupId])
  @@index([mode, refreshCron, nextRefreshAt])
  @@map("cw_dataset_sources")
}

model Upload {
  id               String        @id @default(uuid()) @db.Uuid
  datasetId        String?       @map("dataset_id") @db.Uuid
  tableId          String?       @map("table_id") @db.Uuid
  originalFilename String        @map("original_filename") @db.VarChar(500)
  blobName         String        @unique @map("blob_name") @db.VarChar(700)
  sizeBytes        BigInt        @map("size_bytes")
  mode             String        @default("replace") @db.VarChar(20)
  keyColumn        String?       @map("key_column") @db.VarChar(128)
  fullSnapshot     Boolean       @default(false) @map("full_snapshot")
  status           String        @default("PENDING_UPLOAD") @db.VarChar(32)
  progress         Int           @default(0)
  previewJson      String?       @map("preview_json") @db.Text
  mappingJson      String?       @map("mapping_json") @db.Text
  typeOverridesJson String?      @map("type_overrides_json") @db.Text
  rowCount         BigInt?       @map("row_count")
  insertedCount    BigInt?       @map("inserted_count")
  updatedCount     BigInt?       @map("updated_count")
  fileHash         String?       @map("file_hash") @db.VarChar(32)
  deltaJson        String?       @map("delta_json") @db.Text
  errorMessage     String?       @map("error_message") @db.Text
  /// Quem enviou (e-mail do usuario ou token:<nome>); nulo em uploads anteriores a este campo.
  createdBy        String?       @map("created_by") @db.VarChar(255)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  dataset          Dataset?      @relation(fields: [datasetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  table            DatasetTable? @relation(fields: [tableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobs             Job[]

  @@index([status, createdAt])
  @@map("cw_uploads")
}

model DatasetVersion {
  id         String       @id @default(uuid()) @db.Uuid
  tableId    String       @map("table_id") @db.Uuid
  uploadId   String?      @map("upload_id") @db.Uuid
  rowCount   BigInt       @map("row_count")
  schemaJson String       @map("schema_json") @db.Text
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  table      DatasetTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, createdAt])
  @@map("cw_dataset_versions")
}

model SavedQuery {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(1000)
  sqlText     String   @map("sql_text") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("cw_saved_queries")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  tokenId      String?  @map("token_id") @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(80)
  resourceType String?  @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(255)
  detailJson   String?  @map("detail_json") @db.Text
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  success      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  user         User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@map("cw_audit_events")
}

model DerivedTable {
  id              String        @id @default(uuid()) @db.Uuid
  datasetId       String        @map("dataset_id") @db.Uuid
  targetTableId   String?       @map("target_table_id") @db.Uuid
  name            String        @db.VarChar(255)
  sqlName         String        @map("sql_name") @db.VarChar(128)
  querySql        String        @map("query_sql") @db.Text
  refreshCron     String?       @map("refresh_cron") @db.VarChar(100)
  lastStatus      String?       @map("last_status") @db.VarChar(32)
  lastRowCount    BigInt?       @map("last_row_count")
  lastError       String?       @map("last_error") @db.Text
  lastRefreshedAt DateTime?     @map("last_refreshed_at") @db.Timestamp(3)
  nextRefreshAt   DateTime?     @map("next_refresh_at") @db.Timestamp(3)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  dataset         Dataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  targetTable     DatasetTable? @relation("DerivedTarget", fields: [targetTableId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([datasetId, active])
  @@index([nextRefreshAt])
  @@map("cw_derived_tables")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(50)
  status      String    @default("QUEUED") @db.VarChar(20)
  uploadId    String?   @map("upload_id") @db.Uuid
  payloadJson String?   @map("payload_json") @db.Text
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamp(3)
  lockedAt    DateTime? @map("locked_at") @db.Timestamp(3)
  lockedBy    String?   @map("locked_by") @db.VarChar(120)
  heartbeatAt DateTime? @map("heartbeat_at") @db.Timestamp(3)
  /// RSS (MB) do processo worker na ultima pulsacao — se o job morrer no meio,
  /// essa e a ultima leitura de memoria antes do processo travar/crashar.
  heartbeatRssMb Int?   @map("heartbeat_rss_mb")
  weight      Int       @default(0) @db.SmallInt
  /// Só setado em SOURCE_REFRESH (ver queueSourceRefresh em sources.ts) — usado pelo
  /// claim() do worker pra gatear quantos syncs rodam ao mesmo tempo por storage
  /// (maxSyncsPerStorage). NULL em qualquer outro tipo de job (nunca gateado por isso).
  storageServerId String? @map("storage_server_id") @db.VarChar(64)
  lastError   String?   @map("last_error") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
  upload      Upload?   @relation(fields: [uploadId], references: [id])

  @@index([status, availableAt])
  @@index([status, storageServerId])
  @@map("cw_jobs")
}

/// Auditoria de custo por job — sobrevive a limpeza de cw_jobs (METADATA_CLEANUP
/// apaga jobs antigos; esta tabela fica pra analise historica de memoria/duracao).
model JobMetric {
  id            String   @id @default(uuid()) @db.Uuid
  jobId         String   @map("job_id") @db.Uuid
  jobType       String   @map("job_type") @db.VarChar(50)
  status        String   @db.VarChar(20)
  weight        Int      @db.SmallInt
  fileSizeBytes BigInt?  @map("file_size_bytes")
  rssBeforeMb   Int?     @map("rss_before_mb")
  rssAfterMb    Int?     @map("rss_after_mb")
  durationMs    Int?     @map("duration_ms")
  errorMessage  String?  @map("error_message") @db.Text
  workerLabel   String?  @map("worker_label") @db.VarChar(120)
  /// Tabela que a execucao alimentou (historico por tabela); nulo antes deste campo.
  tableId       String?  @map("table_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([tableId, createdAt])
  @@index([createdAt])
  @@index([jobType, createdAt])
  @@map("cw_job_metrics")
}

model StorageServer {
  id                   String    @id @db.Uuid
  name                 String    @db.VarChar(120)
  /// Connection URL: sqlserver://host:port;database=...;user=...;password=...
  url                  String?   @db.Text
  provider             String    @default("sqlserver") @db.VarChar(50)
  server               String    @default("") @db.VarChar(255)
  port                 Int       @default(1433)
  databaseName         String    @default("") @map("database_name") @db.VarChar(255)
  encryptedCredentials String    @default("") @map("encrypted_credentials") @db.Text
  sslMode              String    @default("none") @map("ssl_mode") @db.VarChar(50)
  encrypt              Boolean   @default(true)
  isDefault            Boolean   @default(false) @map("is_default")
  active               Boolean   @default(true)
  lastStatus           String?   @map("last_status") @db.VarChar(50)
  lastLatencyMs        Int?      @map("last_latency_ms")
  lastCheckedAt        DateTime? @map("last_checked_at") @db.Timestamp(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
  datasets             Dataset[]

  @@map("cw_storage_servers")
}

// Perfis de worker (ver docs/worker-architecture.md): o supervisor sobe um processo por perfil habilitado.
model WorkerProfile {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String          @unique @db.VarChar(64)
  jobTypes          String[]        @map("job_types")
  concurrency       Int             @default(1)
  pollMs            Int             @default(2000) @map("poll_ms")
  duckdbMemoryLimit String          @default("1GB") @map("duckdb_memory_limit") @db.VarChar(16)
  enabled           Boolean         @default(true)
  revision          Int             @default(1)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  commands          SystemCommand[]

  @@map("cw_worker_profiles")
}

model SystemCommand {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action        String         @db.VarChar(24)
  mode          String         @default("SAFE") @db.VarChar(12)
  profileId     String?        @map("profile_id") @db.Uuid
  status        String         @default("PENDING") @db.VarChar(12)
  timeoutMs     Int            @default(600000) @map("timeout_ms")
  requestedBy   String         @map("requested_by") @db.VarChar(255)
  requestedById String?        @map("requested_by_id") @db.Uuid
  requestedAt   DateTime       @default(now()) @map("requested_at") @db.Timestamptz(3)
  startedAt     DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?      @map("finished_at") @db.Timestamptz(3)
  resultJson    String?        @map("result_json")
  profile       WorkerProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@map("cw_system_commands")
}

model SupervisorState {
  instanceId   String   @id @map("instance_id") @db.VarChar(120)
  hostname     String?  @db.VarChar(255)
  pid          Int?
  startedAt    DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  heartbeatAt  DateTime @default(now()) @map("heartbeat_at") @db.Timestamptz(3)
  childrenJson String?  @map("children_json")

  @@map("cw_supervisor_state")
}

model SystemSetting {
  key       String   @id @db.VarChar(120)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("cw_system_settings")
}

// Lock por linha usado por withImportLock (server/db/import-lock.ts) pra serializar
// imports concorrentes na mesma tabela SEM segurar uma transacao Postgres aberta
// durante todo o trabalho externo no SQL Server (ver advisory-lock.ts pro mecanismo
// antigo, ainda usado pros writes curtos de metadata).
model ImportLock {
  lockKey   String   @id @map("lock_key") @db.VarChar(160)
  lockedAt  DateTime @map("locked_at") @db.Timestamp(3)
  lockedBy  String   @map("locked_by") @db.VarChar(160)
  expiresAt DateTime @map("expires_at") @db.Timestamp(3)

  @@map("cw_import_locks")
}

model CleanupRun {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  durationMs      Int?      @map("duration_ms")
  deletedJobs     Int       @default(0) @map("deleted_jobs")
  deletedAudit    Int       @default(0) @map("deleted_audit")
  deletedUploads  Int       @default(0) @map("deleted_uploads")
  deletedFiles    Int       @default(0) @map("deleted_files")
  deletedOrphans  Int       @default(0) @map("deleted_orphans")
  deletedVersions Int       @default(0) @map("deleted_versions")
  error           String?   @db.Text

  @@map("cw_cleanup_runs")
}
