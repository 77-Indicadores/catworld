generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("CATWORLD_DATABASE_URL")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(160)
  email        String        @unique @db.VarChar(320)
  passwordHash String        @map("password_hash") @db.VarChar(500)
  role         String        @default("VIEWER") @db.VarChar(32)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  grants       AccessGrant[]
  savedQueries SavedQuery[]
  auditEvents  AuditEvent[]

  @@map("cw_users")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(100)
  description String?       @db.VarChar(1000)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  datasets    Dataset[]
  grants      AccessGrant[]

  @@map("cw_projects")
}

model Dataset {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  name        String         @db.VarChar(255)
  slug        String         @db.VarChar(100)
  description String?        @db.VarChar(1000)
  schemaName      String         @unique @map("schema_name") @db.VarChar(128)
  storageServerId String?        @map("storage_server_id") @db.Uuid
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamp(3)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  storageServer   StorageServer? @relation(fields: [storageServerId], references: [id])
  tables          DatasetTable[]
  grants          AccessGrant[]
  uploads         Upload[]
  sources         DatasetSource[]
  derivedTables   DerivedTable[]

  @@unique([projectId, slug])
  @@index([projectId, active])
  @@map("cw_datasets")
}

model DatasetTable {
  id        String           @id @default(uuid()) @db.Uuid
  datasetId String           @map("dataset_id") @db.Uuid
  name      String           @db.VarChar(255)
  sqlName   String           @map("sql_name") @db.VarChar(128)
  rowCount   BigInt           @default(0) @map("row_count")
  sizeBytes  BigInt           @default(0) @map("size_bytes")
  lastDataAt DateTime?        @map("last_data_at") @db.Timestamp(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamp(3)
  dataset   Dataset          @relation(fields: [datasetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  columns   DatasetColumn[]
  versions  DatasetVersion[]
  uploads      Upload[]
  source       DatasetSource?
  derivedTables DerivedTable[] @relation("DerivedTarget")

  @@unique([datasetId, sqlName])
  @@map("cw_tables")
}

model DatasetColumn {
  id           String       @id @default(uuid()) @db.Uuid
  tableId      String       @map("table_id") @db.Uuid
  ordinal      Int
  originalName String       @map("original_name") @db.VarChar(255)
  sqlName      String       @map("sql_name") @db.VarChar(128)
  sqlType      String       @map("sql_type") @db.VarChar(100)
  nullable     Boolean      @default(true)
  table        DatasetTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, sqlName])
  @@index([tableId, ordinal])
  @@map("cw_columns")
}

model ApiToken {
  id         String        @id @default(uuid()) @db.Uuid
  name       String        @db.VarChar(160)
  prefix     String        @unique @db.VarChar(24)
  tokenHash  String        @unique @map("token_hash") @db.Char(64)
  active     Boolean       @default(true)
  expiresAt  DateTime?     @map("expires_at") @db.Timestamp(3)
  lastUsedAt DateTime?     @map("last_used_at") @db.Timestamp(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  grants     AccessGrant[]

  @@map("cw_tokens")
}

model DatabaseUser {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @unique @db.VarChar(128)
  kind              String        @db.VarChar(32)
  encryptedPassword String        @map("encrypted_password") @db.VarChar(1000)
  active            Boolean       @default(true)
  lastUsedAt        DateTime?     @map("last_used_at") @db.Timestamp(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  grants            AccessGrant[]

  @@map("cw_database_users")
}

model AccessGrant {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  tokenId        String?       @map("token_id") @db.Uuid
  databaseUserId String?       @map("database_user_id") @db.Uuid
  scopeType      String        @map("scope_type") @db.VarChar(20)
  projectId      String?       @map("project_id") @db.Uuid
  datasetId      String?       @map("dataset_id") @db.Uuid
  permission     String        @db.VarChar(20)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          ApiToken?     @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  databaseUser   DatabaseUser? @relation(fields: [databaseUserId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dataset        Dataset?      @relation(fields: [datasetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([tokenId])
  @@index([databaseUserId])
  @@map("cw_access_grants")
}

model Connection {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String    @db.VarChar(120)
  provider             String    @default("postgres") @db.VarChar(32)
  environment          String    @db.VarChar(32)
  server               String    @db.VarChar(255)
  port                 Int?
  databaseName         String    @map("database_name") @db.VarChar(128)
  sslMode              String    @default("require") @map("ssl_mode") @db.VarChar(32)
  username             String    @db.VarChar(255)
  encryptedCredentials String    @map("encrypted_credentials") @db.VarChar(2000)
  metadataJson         String?   @map("metadata_json") @db.Text
  active               Boolean   @default(true)
  lastStatus           String?   @map("last_status") @db.VarChar(32)
  lastLatencyMs        Int?      @map("last_latency_ms")
  lastCheckedAt        DateTime? @map("last_checked_at") @db.Timestamp(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
  sources              DatasetSource[]

  @@map("cw_connections")
}

model DatasetSource {
  id              String        @id @default(uuid()) @db.Uuid
  datasetId       String        @map("dataset_id") @db.Uuid
  connectionId    String        @map("connection_id") @db.Uuid
  targetTableId   String?       @unique @map("target_table_id") @db.Uuid
  name            String        @db.VarChar(255)
  mode            String        @db.VarChar(20)
  sourceKind      String        @map("source_kind") @db.VarChar(20)
  sourceGroupId   String?       @map("source_group_id") @db.Uuid
  sourceSchema    String?       @map("source_schema") @db.VarChar(128)
  sourceTable     String?       @map("source_table") @db.VarChar(128)
  sourceSql       String?       @map("source_sql") @db.Text
  refreshCron     String?       @map("refresh_cron") @db.VarChar(100)
  keyColumn       String?       @map("key_column") @db.VarChar(128)
  deltaColumn     String?       @map("delta_column") @db.VarChar(128)
  lastDeltaValue  String?       @map("last_delta_value") @db.Text
  lastStatus      String?       @map("last_status") @db.VarChar(32)
  lastRowCount    BigInt?       @map("last_row_count")
  lastError       String?       @map("last_error") @db.Text
  lastRefreshedAt DateTime?     @map("last_refreshed_at") @db.Timestamp(3)
  nextRefreshAt   DateTime?     @map("next_refresh_at") @db.Timestamp(3)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  dataset         Dataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  connection      Connection    @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetTable     DatasetTable? @relation(fields: [targetTableId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([datasetId, active])
  @@index([connectionId])
  @@index([sourceGroupId])
  @@index([mode, refreshCron, nextRefreshAt])
  @@map("cw_dataset_sources")
}

model Upload {
  id               String        @id @default(uuid()) @db.Uuid
  datasetId        String?       @map("dataset_id") @db.Uuid
  tableId          String?       @map("table_id") @db.Uuid
  originalFilename String        @map("original_filename") @db.VarChar(500)
  blobName         String        @unique @map("blob_name") @db.VarChar(700)
  sizeBytes        BigInt        @map("size_bytes")
  mode             String        @default("replace") @db.VarChar(20)
  keyColumn        String?       @map("key_column") @db.VarChar(128)
  status           String        @default("PENDING_UPLOAD") @db.VarChar(32)
  progress         Int           @default(0)
  previewJson      String?       @map("preview_json") @db.Text
  mappingJson      String?       @map("mapping_json") @db.Text
  rowCount         BigInt?       @map("row_count")
  insertedCount    BigInt?       @map("inserted_count")
  updatedCount     BigInt?       @map("updated_count")
  fileHash         String?       @map("file_hash") @db.VarChar(32)
  deltaJson        String?       @map("delta_json") @db.Text
  errorMessage     String?       @map("error_message") @db.Text
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  dataset          Dataset?      @relation(fields: [datasetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  table            DatasetTable? @relation(fields: [tableId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobs             Job[]

  @@index([status, createdAt])
  @@map("cw_uploads")
}

model DatasetVersion {
  id         String       @id @default(uuid()) @db.Uuid
  tableId    String       @map("table_id") @db.Uuid
  uploadId   String?      @map("upload_id") @db.Uuid
  rowCount   BigInt       @map("row_count")
  schemaJson String       @map("schema_json") @db.Text
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamp(3)
  table      DatasetTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, createdAt])
  @@map("cw_dataset_versions")
}

model SavedQuery {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(1000)
  sqlText     String   @map("sql_text") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("cw_saved_queries")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  tokenId      String?  @map("token_id") @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(80)
  resourceType String?  @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(255)
  detailJson   String?  @map("detail_json") @db.Text
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  success      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  user         User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@map("cw_audit_events")
}

model DerivedTable {
  id              String        @id @default(uuid()) @db.Uuid
  datasetId       String        @map("dataset_id") @db.Uuid
  targetTableId   String?       @map("target_table_id") @db.Uuid
  name            String        @db.VarChar(255)
  sqlName         String        @map("sql_name") @db.VarChar(128)
  querySql        String        @map("query_sql") @db.Text
  refreshCron     String?       @map("refresh_cron") @db.VarChar(100)
  lastStatus      String?       @map("last_status") @db.VarChar(32)
  lastRowCount    BigInt?       @map("last_row_count")
  lastError       String?       @map("last_error") @db.Text
  lastRefreshedAt DateTime?     @map("last_refreshed_at") @db.Timestamp(3)
  nextRefreshAt   DateTime?     @map("next_refresh_at") @db.Timestamp(3)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  dataset         Dataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  targetTable     DatasetTable? @relation("DerivedTarget", fields: [targetTableId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([datasetId, active])
  @@index([nextRefreshAt])
  @@map("cw_derived_tables")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(50)
  status      String    @default("QUEUED") @db.VarChar(20)
  uploadId    String?   @map("upload_id") @db.Uuid
  payloadJson String?   @map("payload_json") @db.Text
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamp(3)
  lockedAt    DateTime? @map("locked_at") @db.Timestamp(3)
  lockedBy    String?   @map("locked_by") @db.VarChar(120)
  heartbeatAt DateTime? @map("heartbeat_at") @db.Timestamp(3)
  weight      Int       @default(0) @db.SmallInt
  lastError   String?   @map("last_error") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
  upload      Upload?   @relation(fields: [uploadId], references: [id])

  @@index([status, availableAt])
  @@map("cw_jobs")
}

model StorageServer {
  id                   String    @id @db.Uuid
  name                 String    @db.VarChar(120)
  /// Connection URL: sqlserver://host:port;database=...;user=...;password=...
  url                  String?   @db.Text
  provider             String    @default("sqlserver") @db.VarChar(50)
  server               String    @default("") @db.VarChar(255)
  port                 Int       @default(1433)
  databaseName         String    @default("") @map("database_name") @db.VarChar(255)
  encryptedCredentials String    @default("") @map("encrypted_credentials") @db.Text
  sslMode              String    @default("none") @map("ssl_mode") @db.VarChar(50)
  encrypt              Boolean   @default(true)
  isDefault            Boolean   @default(false) @map("is_default")
  active               Boolean   @default(true)
  lastStatus           String?   @map("last_status") @db.VarChar(50)
  lastLatencyMs        Int?      @map("last_latency_ms")
  lastCheckedAt        DateTime? @map("last_checked_at") @db.Timestamp(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
  datasets             Dataset[]

  @@map("cw_storage_servers")
}

model SystemSetting {
  key       String   @id @db.VarChar(120)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(3)

  @@map("cw_system_settings")
}
