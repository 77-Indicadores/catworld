CATWORLD_DATABASE_URL="postgres://catworld:change-me@localhost:5432/catworld"
CATWORLD_ENCRYPTION_KEY="base64-encoded-32-byte-key"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
AUTH_URL="http://localhost:3000"
CATWORLD_PUBLIC_ORIGIN="http://localhost:3000"
CATWORLD_UPLOAD_DIR="./var/uploads"
CATWORLD_ADMIN_EMAIL="admin@example.com"
CATWORLD_ADMIN_PASSWORD="change-this-password"
CATWORLD_ADMIN_NAME="Administrador"

# Workers NÃO se configuram aqui: perfis, concorrência, tipos de job, limites de upload e afins ficam em
# Configurações > Worker (banco de dados). Subir o serviço "workers" (supervisor) é o suficiente; veja docs/worker-architecture.md.
