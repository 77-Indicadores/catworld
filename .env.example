CATWORLD_DATABASE_URL="sqlserver://server.database.windows.net:1433;database=catworld;user=catworld_admin;password=change-me;encrypt=true;trustServerCertificate=false"
CATWORLD_ENCRYPTION_KEY="base64-encoded-32-byte-key"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
AUTH_URL="http://localhost:3000"
CATWORLD_PUBLIC_ORIGIN="http://localhost:3000"
CATWORLD_UPLOAD_DIR="./var/uploads"
CATWORLD_ADMIN_EMAIL="admin@example.com"
CATWORLD_ADMIN_PASSWORD="change-this-password"
CATWORLD_ADMIN_NAME="Administrador"
CATWORLD_WORKER_ID="worker-1"
CATWORLD_WORKER_CONCURRENCY="3"
CATWORLD_MAX_HEAVY_JOBS="2"
# Máximo de syncs de fonte simultâneos por storage (evita saturar pool de conexões)
CATWORLD_MAX_SYNCS_PER_STORAGE="3"
CATWORLD_JOB_POLL_MS="2000"
CATWORLD_UPLOAD_MAX_BYTES="524288000"
# Arquivos XLSX/XLS sao lidos inteiros em memoria (sem streaming) — teto bem mais
# conservador que CATWORLD_UPLOAD_MAX_BYTES (100MB se mostrou perigoso: OOM do worker; 40MB e o default do codigo). CSV nao precisa (100% streamed).
CATWORLD_XLSX_MAX_BYTES="41943040"
# Teto de memoria por instancia DuckDB (uma por import/preview de CSV)
CATWORLD_DUCKDB_MEMORY_LIMIT="1GB"
# Pausa entre batches de import (ms). 0 = maxima velocidade. Pode ser sobrescrito no painel (Configuracoes > Worker).
CATWORLD_IMPORT_BATCH_DELAY_MS="200"
# Restringe os tipos de job deste worker (separados por virgula). Vazio = todos.
# Validos: PREVIEW_UPLOAD, IMPORT_UPLOAD, SOURCE_REFRESH, DERIVED_REFRESH, METADATA_CLEANUP
# CATWORLD_WORKER_JOB_TYPES=""
